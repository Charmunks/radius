{% extends "layouts/base.njk" %}

{% block title %}Radius{% endblock %}

{% block content %}
<main class="app">
  <aside class="panel">
    <div class="title-row">
      <h1>Radius</h1>
      <button id="theme-toggle" class="theme-toggle" type="button"></button>
    </div>
    <div id="install" class="install" hidden>
      <p id="install-text"></p>
      <div class="install-actions">
        <button id="install-go" type="button" hidden>Add to home screen</button>
        <button id="install-dismiss" type="button" class="secondary">Not now</button>
      </div>
    </div>
    <p class="sub">Tell us what you're into and we'll pick one place and show you exactly how to get there.</p>

    <div class="pick">Starting from
      <div class="start-row">
        <span id="start-label" class="start-label">Your current location</span>
        <button id="start-reset" type="button" class="link" hidden>Use my location</button>
      </div>
      <form id="start-search" class="start-search">
        <input id="start-q" type="search" placeholder="Or search, e.g. Union Station" aria-label="Search for a starting point" autocomplete="off">
        <button type="submit" class="secondary">Search</button>
      </form>
      <ul id="start-results" class="start-results" hidden></ul>
      <button id="drop-pin" type="button" class="link">Or drop a pin on the map</button>
    </div>

    <label class="pick">What are you in the mood for? <span class="hint">Pick one or more</span>
      <select id="interests" multiple size="6">
        {% for c in categories %}
        <option value="{{ c.id }}"{% if loop.first %} selected{% endif %}>{{ c.label }}</option>
        {% endfor %}
      </select>
    </label>

    <label class="pick">How are you getting there?
      <select id="mode">
        <option value="transit">Public Transit</option>
        <option value="walking">Walking</option>
        <option value="driving">Driving</option>
      </select>
    </label>

    <label class="pick">Max travel time
      <select id="max-minutes">
        <option value="">Any</option>
        <option value="15">15 minutes</option>
        <option value="30">30 minutes</option>
        <option value="45">45 minutes</option>
        <option value="60">1 hour</option>
        <option value="90">1.5 hours</option>
      </select>
    </label>

    <div class="filters">
      <label class="pick">Price
        <select id="price">
          <option value="">Any</option>
          <option value="1">$</option>
          <option value="2">$$</option>
          <option value="3">$$$</option>
          <option value="4">$$$$</option>
        </select>
      </label>
      <label class="check"><input type="checkbox" id="open-now"> Open now</label>
    </div>

    <button id="go">Use my location &amp; go</button>
    <button id="surprise" type="button" class="secondary surprise">Surprise me</button>
    <label class="check mystery"><input type="checkbox" id="mystery"> Keep it a mystery until I get there (Metro trips)</label>
    <p id="status" role="status"></p>
    <section id="result" hidden>
      <img id="dest-img" class="dest-img" alt="" referrerpolicy="no-referrer" hidden>
      <h2 id="dest-name"></h2>
      <p id="dest-meta" class="meta"></p>
      <p id="dest-fsq" class="meta" hidden></p>
      <p id="dest-blurb"></p>
      <div id="actions" class="actions">
        <button id="save" type="button" class="secondary" aria-pressed="false">Save</button>
        <button id="visited" type="button" class="secondary" aria-pressed="false">Been there</button>
        <button id="share" type="button" class="secondary">Share</button>
      </div>
      <div id="rate" class="rate" hidden>
        <span>How was it?</span>
        <button type="button" class="secondary" data-rating="1" aria-pressed="false" aria-label="Thumbs up">👍</button>
        <button type="button" class="secondary" data-rating="-1" aria-pressed="false" aria-label="Thumbs down">👎</button>
      </div>
      <div id="rides" class="rides"></div>
      <h3>How to get there</h3>
      <ol id="steps" class="steps"></ol>
      <button id="reveal" type="button" class="reveal" hidden>I'm here, reveal it</button>
      <p id="directions" hidden><a id="directions-link" class="directions" target="_blank" rel="noopener">Open directions in Google Maps</a></p>
      <button id="reroll" class="secondary">Not feeling it? Pick another</button>
    </section>

    <details id="mine" class="mine">
      <summary>My places</summary>
      <h3>Saved</h3>
      <ul id="saved-list" class="place-list"></ul>
      <h3>Been there</h3>
      <ul id="visit-list" class="place-list"></ul>
    </details>
  </aside>
  <div id="map"></div>
</main>
{% endblock %}

{% block scripts %}<script src="/public/app.js"></script>{% endblock %}
