<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>
    // Set the theme before first paint: saved choice, else the system setting.
    (() => {
      let t = null;
      try { t = localStorage.getItem("theme"); } catch {}
      if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      document.documentElement.dataset.theme = t;
    })();
  </script>
  <title>{% block title %}yelps{% endblock %}</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <link rel="stylesheet" href="/public/style.css">
  <link rel="manifest" href="/public/manifest.webmanifest">
  <link rel="icon" href="/public/icons/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/public/icons/icon-180.png">
  <meta name="theme-color" content="#1e1e2e">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Radius">
</head>
<body>
  {% block content %}{% endblock %}
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
